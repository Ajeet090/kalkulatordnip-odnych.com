---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
---

<Layout
  title="Błąd Serwera (500) | Kalkulator Dni Płodnych"
  description="Wystąpił nieoczekiwany błąd serwera w aplikacji kalkulatordnipłodnych.com. Przepraszamy za niedogodności."
  noindex={true}
>
  <Header />

  <main class="py-20 sm:py-28 bg-[#fafafa]">
    <div class="max-w-2xl mx-auto px-4 text-center space-y-6">
      
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white border border-[#ebebeb] text-3xl shadow-2xs">
        ⚠️
      </div>

      <div class="mono-eyebrow text-[#ee0000]">Błąd 500 • Wewnętrzny Błąd Serwera</div>

      <h1 class="display-xl text-[#171717]">Wystąpił nieoczekiwany problem</h1>

      <p class="body-lg text-[#4d4d4d] max-w-lg mx-auto">
        Przepraszamy, podczas przetwarzania zapytania wystąpił wewnętrzny błąd serwera. Zespół został powiadomiony.
      </p>

      {error && (
        <div class="p-4 rounded-xl bg-white border border-[#ebebeb] text-left font-mono text-xs text-[#ee0000] overflow-x-auto max-w-md mx-auto">
          {error instanceof Error ? error.message : String(error)}
        </div>
      )}

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4">
        <a href="/" class="btn-primary w-full sm:w-auto shadow-sm">
          <span>Wróć do Strony Głównej</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
        </a>
        <button onclick="window.location.reload()" class="btn-secondary w-full sm:w-auto cursor-pointer">
          Odśwież Stronę
        </button>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
