---
---

<section id="kalkulator-ciazy" class="py-12 sm:py-16 bg-white border-b border-[#ebebeb]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center space-y-3 mb-10">
      <div class="mono-eyebrow text-[#eb367f]">Kalkulator Porodu i Rozwoju</div>
      <h2 class="heading-lg text-[#171717]">Kalkulator Ciąży i Terminu Porodu</h2>
      <p class="body-md text-[#4d4d4d] max-w-xl mx-auto">
        Oblicz przewidywany termin narodzin dziecka, aktualny tydzień ciąży oraz zapoznaj się z kluczowymi kamieniami milowymi rozwoju płodu.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Input Panel (5 cols) -->
      <div class="lg:col-span-5 feature-card space-y-5 bg-[#fafafa]">
        <div class="border-b border-[#ebebeb] pb-3">
          <h3 class="heading-md text-[#171717] flex items-center gap-2">
            <svg class="w-5 h-5 text-[#eb367f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            Metoda Obliczeń
          </h3>
        </div>

        <!-- Mode Selector -->
        <div class="space-y-2">
          <label for="preg-calc-mode" class="block text-xs font-medium text-[#171717] uppercase tracking-wider">
            Oblicz na podstawie:
          </label>
          <select id="preg-calc-mode" class="text-input w-full font-mono text-xs bg-white">
            <option value="lmp">Daty ostatniej miesiączki (LMP)</option>
            <option value="conception">Daty zapłodnienia / owulacji</option>
          </select>
        </div>

        <!-- Date Input -->
        <div class="space-y-2">
          <label id="preg-date-label" for="preg-date-input" class="block text-xs font-medium text-[#171717] uppercase tracking-wider">
            Pierwszy dzień ostatniej miesiączki:
          </label>
          <input 
            type="date" 
            id="preg-date-input" 
            class="text-input w-full font-mono text-sm shadow-2xs bg-white"
          />
        </div>

        <!-- Cycle Length (for LMP mode) -->
        <div id="preg-cycle-wrapper" class="space-y-2">
          <div class="flex justify-between items-center">
            <label for="preg-cycle-len" class="text-xs font-medium text-[#171717]">Długość cyklu:</label>
            <span id="preg-cycle-val" class="font-mono text-xs font-semibold text-[#eb367f]">28 dni</span>
          </div>
          <input 
            type="range" 
            id="preg-cycle-len" 
            min="20" 
            max="45" 
            value="28" 
            aria-label="Długość cyklu w dniach"
            class="w-full accent-[#171717] cursor-pointer"
          />
        </div>

        <button 
          type="button" 
          id="calc-preg-btn" 
          class="btn-primary w-full py-3 text-sm font-semibold shadow-sm"
        >
          Oblicz Tydzień Ciąży i Poród
        </button>
      </div>

      <!-- Results Display (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Due Date Main Banner -->
        <div class="feature-card-elevated bg-gradient-to-r from-white via-[#fafafa] to-white border-l-4 border-l-[#eb367f] p-6 space-y-3">
          <div class="flex justify-between items-start">
            <div>
              <div class="mono-eyebrow text-[#eb367f]">Przewidywany Termin Porodu</div>
              <div id="preg-due-date" class="font-mono text-2xl sm:text-3xl font-bold text-[#171717] mt-1">
                --.--.----
              </div>
            </div>
            <div class="bg-[#eb367f]/10 text-[#eb367f] text-xs font-mono font-semibold px-3 py-1 rounded-full">
              40. Tydzień Narodzin
            </div>
          </div>
          <p id="preg-due-day" class="text-xs text-[#4d4d4d] font-medium">
            Wprowadź dane po lewej stronie, aby wyliczyć wiek ciążowy.
          </p>
        </div>

        <!-- Current Progress & Trimester -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="feature-card bg-white">
            <div class="mono-eyebrow text-[#8f8f8f] mb-1">Obecny Wiek Ciąży</div>
            <div id="preg-current-week" class="font-mono text-xl font-semibold text-[#171717]">
              --. tydzień
            </div>
            <div id="preg-days-remaining" class="text-xs text-[#8f8f8f] mt-1">
              Pozostało ok. --- dni do porodu
            </div>
          </div>

          <div class="feature-card bg-white">
            <div class="mono-eyebrow text-[#8f8f8f] mb-1">Obecny Trymestr</div>
            <div id="preg-trimester" class="font-mono text-xl font-semibold text-[#171717]">
              -- Trymestr
            </div>
            <div id="preg-trimester-desc" class="text-xs text-[#8f8f8f] mt-1">
              Kluczowy okres kształtowania narządów
            </div>
          </div>
        </div>

        <!-- Pregnancy Milestones Timeline -->
        <div class="feature-card space-y-4">
          <div class="border-b border-[#ebebeb] pb-3 flex items-center justify-between">
            <h4 class="heading-md text-sm text-[#171717]">Kamienie Milowe i Badania Lekarskie</h4>
            <span class="mono-eyebrow text-[10px] text-[#8f8f8f]">Kalendarz Badań USG</span>
          </div>

          <div id="milestones-container" class="space-y-3 font-mono text-xs">
            <!-- Populated dynamically by JS -->
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const pregModeSelect = document.getElementById('preg-calc-mode') as HTMLSelectElement;
  const pregDateInput = document.getElementById('preg-date-input') as HTMLInputElement;
  const pregDateLabel = document.getElementById('preg-date-label');
  const pregCycleLenInput = document.getElementById('preg-cycle-len') as HTMLInputElement;
  const pregCycleVal = document.getElementById('preg-cycle-val');
  const pregCycleWrapper = document.getElementById('preg-cycle-wrapper');
  const calcPregBtn = document.getElementById('calc-preg-btn');

  const pregDueDate = document.getElementById('preg-due-date');
  const pregDueDay = document.getElementById('preg-due-day');
  const pregCurrentWeek = document.getElementById('preg-current-week');
  const pregDaysRemaining = document.getElementById('preg-days-remaining');
  const pregTrimester = document.getElementById('preg-trimester');
  const pregTrimesterDesc = document.getElementById('preg-trimester-desc');
  const milestonesContainer = document.getElementById('milestones-container');

  const daysPl = ['Niedziela', 'Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota'];

  // Default Date: 40 days ago
  const defaultDate = new Date();
  defaultDate.setDate(defaultDate.getDate() - 40);
  if (pregDateInput) {
    pregDateInput.value = defaultDate.toISOString().split('T')[0];
  }

  pregModeSelect?.addEventListener('change', () => {
    if (pregModeSelect.value === 'conception') {
      if (pregDateLabel) pregDateLabel.textContent = 'Data zapłodnienia / owulacji:';
      if (pregCycleWrapper) pregCycleWrapper.classList.add('hidden');
    } else {
      if (pregDateLabel) pregDateLabel.textContent = 'Pierwszy dzień ostatniej miesiączki:';
      if (pregCycleWrapper) pregCycleWrapper.classList.remove('hidden');
    }
    calculatePregnancy();
  });

  pregCycleLenInput?.addEventListener('input', () => {
    if (pregCycleVal) pregCycleVal.textContent = `${pregCycleLenInput.value} dni`;
    calculatePregnancy();
  });

  pregDateInput?.addEventListener('change', calculatePregnancy);
  calcPregBtn?.addEventListener('click', calculatePregnancy);

  function formatDate(d: Date): string {
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const yyyy = d.getFullYear();
    return `${dd}.${mm}.${yyyy}`;
  }

  function calculatePregnancy() {
    if (!pregDateInput || !pregDateInput.value) return;

    const inputDate = new Date(pregDateInput.value);
    if (isNaN(inputDate.getTime())) return;

    const mode = pregModeSelect.value;
    const cycleLen = parseInt(pregCycleLenInput.value, 10) || 28;

    let dueDate = new Date(inputDate);

    if (mode === 'lmp') {
      // Modified Naegele's rule: EDD = LMP + 280 days + (Cycle length - 28)
      const offset = 280 + (cycleLen - 28);
      dueDate.setDate(inputDate.getDate() + offset);
    } else {
      // Conception mode: EDD = Conception + 266 days
      dueDate.setDate(inputDate.getDate() + 266);
    }

    const today = new Date();
    // Calculate current gestational age
    const totalDays = Math.floor((today.getTime() - (dueDate.getTime() - 280 * 86400000)) / (86400000));
    const currentWeeks = Math.floor(totalDays / 7);
    const currentDays = Math.max(0, totalDays % 7);

    const daysRemaining = Math.max(0, Math.floor((dueDate.getTime() - today.getTime()) / 86400000));

    // Update UI
    if (pregDueDate) pregDueDate.textContent = formatDate(dueDate);
    if (pregDueDay) pregDueDay.textContent = `Dzień tygodnia porodu: ${daysPl[dueDate.getDay()]}`;

    if (pregCurrentWeek) {
      if (currentWeeks < 0) {
        pregCurrentWeek.textContent = 'Przed ciążą';
      } else if (currentWeeks > 42) {
        pregCurrentWeek.textContent = 'Po terminie';
      } else {
        pregCurrentWeek.textContent = `${currentWeeks}. tydzień i ${currentDays}. dzień`;
      }
    }

    if (pregDaysRemaining) pregDaysRemaining.textContent = `Pozostało ok. ${daysRemaining} dni do porodu`;

    // Trimester
    if (pregTrimester) {
      if (currentWeeks <= 13) {
        pregTrimester.textContent = '1. Trymestr';
        if (pregTrimesterDesc) pregTrimesterDesc.textContent = 'Tygodnie 1-13: Organogeneza, badanie I trymestru';
      } else if (currentWeeks <= 27) {
        pregTrimester.textContent = '2. Trymestr';
        if (pregTrimesterDesc) pregTrimesterDesc.textContent = 'Tygodnie 14-27: Intensywny wzrost, USG połówkowe';
      } else {
        pregTrimester.textContent = '3. Trymestr';
        if (pregTrimesterDesc) pregTrimesterDesc.textContent = 'Tygodnie 28-40: Przygotowanie narządów i powitanie maluszka';
      }
    }

    renderMilestones(dueDate);
  }

  function renderMilestones(dueDate: Date) {
    if (!milestonesContainer) return;

    // Start date = Due Date - 280 days
    const lmpEst = new Date(dueDate);
    lmpEst.setDate(dueDate.getDate() - 280);

    const list = [
      { week: 6, title: 'Pojawienie się bicia serca (Echo serca płodu)', desc: 'Widoczny pęcherzyk ciążowy i czynność serca w USG' },
      { week: 12, title: 'USG I Trymestru & Test PAPP-A', desc: 'Ocena przejaśnienia karkowego (NT) i kości nosowej' },
      { week: 20, title: 'USG Połówkowe (Genetyczne)', desc: 'Szczegółowa ocena anatomii narządów i ewentualnie płeć!' },
      { week: 24, title: 'Test Obciążenia Glukozą (OGTT)', desc: 'Diagnostyka cukrzycy ciążowej (krzywa cukrowa)' },
      { week: 28, title: 'Początek III Trymestru', desc: 'Dziecko otwiera oczy, dynamiczny rozwój mózgu' },
      { week: 37, title: 'Ciąża Donoszona!', desc: 'Płuca dziecka są w pełni gotowe do samodzielnego oddechu' },
      { week: 40, title: 'Przewidywany Termin Porodu 🎂', desc: 'Dzień narodzin twojego maluszka' }
    ];

    milestonesContainer.innerHTML = list.map(m => {
      const mDate = new Date(lmpEst);
      mDate.setDate(lmpEst.getDate() + m.week * 7);
      const formatted = formatDate(mDate);

      return `
        <div class="flex items-start gap-3 p-3 rounded-lg border border-[#ebebeb] bg-white hover:bg-[#fafafa] transition-colors">
          <div class="bg-[#171717] text-white font-mono text-[10px] px-2 py-1 rounded font-semibold whitespace-nowrap">
            ${m.week}. Tydz.
          </div>
          <div class="space-y-0.5">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-[#171717]">${m.title}</span>
              <span class="text-[#8f8f8f] font-mono text-[11px]">• ${formatted}</span>
            </div>
            <p class="text-[11px] text-[#4d4d4d] font-sans">${m.desc}</p>
          </div>
        </div>
      `;
    }).join('');
  }

  // Initial calculation (scheduled via rAF to avoid blocking initial paint)
  if (typeof requestAnimationFrame !== 'undefined') {
    requestAnimationFrame(calculatePregnancy);
  } else {
    calculatePregnancy();
  }
</script>
