---
const articles = [
  {
    category: "EDUKACJA MEDYCZNA",
    title: "Jak rozpoznać owulację przy nieregularnych cyklach?",
    description: "Nieregularny cykl menstruacyjny utrudnia tradycyjne obliczenia kalendarzowe. Poznaj połączenie objawów fizjologicznych z testami LH i usg folikulometrii.",
    readTime: "5 min czytania",
    badgeColor: "text-[#0070f3]"
  },
  {
    category: "SUPLEMENTACJA & DIETA",
    title: "Dieta wspierająca płodność i jakość komórki jajowej",
    description: "Rola kwasu foliowego, inozytolu (Myo-inozytol), witaminy D3, cynku i kwasów Omega-3 w optymalizacji cyklu owulacyjnego kobiety i parametrów nasienia.",
    readTime: "7 min czytania",
    badgeColor: "text-[#10b981]"
  },
  {
    category: "FAKTY I MITY",
    title: "Mity na temat dni płodnych: Czy można zajść w ciążę podczas okresu?",
    description: "Wyjaśniamy biologiczne fakty dotyczące żywotności plemników, krótszych cykli folikularnych oraz różnicy między plamieniem owulacyjnym a miesiączką.",
    readTime: "4 min czytania",
    badgeColor: "text-[#eb367f]"
  },
  {
    category: "DIAGNOSTYKA KOBIET",
    title: "Badania hormonalne w ocenie owulacji: AMH, Progesteron, FSH, LH",
    description: "Przewodnik po najważniejszych badaniach z krwi: kiedy badać rezerwę jajnikową (AMH) oraz stężenie progesteronu 7 dni po owulacji.",
    readTime: "6 min czytania",
    badgeColor: "text-[#7928ca]"
  }
];
---

<section class="py-12 sm:py-16 bg-white border-b border-[#ebebeb]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center space-y-3 mb-10">
      <div class="mono-eyebrow text-[#171717]">Wiedza i Ekspertyza</div>
      <h2 class="heading-lg text-[#171717]">Baza Wiedzy o Płodności i Cyklu</h2>
      <p class="body-md text-[#4d4d4d] max-w-xl mx-auto">
        Poparte nauką artykuły i wskazówki ginekologiczne pomagające zrozumieć fizjologię płodności.
      </p>
    </div>

    <!-- Article Cards Grid per DESIGN.md feature-card specs -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articles.map(art => (
        <div class="feature-card space-y-3 flex flex-col justify-between hover:border-[#c4c4c4] transition-all">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class={`mono-eyebrow text-[11px] ${art.badgeColor}`}>{art.category}</span>
              <span class="font-mono text-[11px] text-[#8f8f8f]">{art.readTime}</span>
            </div>
            <h3 class="heading-md text-base text-[#171717] leading-snug">
              {art.title}
            </h3>
            <p class="body-sm text-[#4d4d4d]">
              {art.description}
            </p>
          </div>
          
          <div class="pt-2 flex items-center text-xs font-semibold text-[#171717] gap-1 hover:text-[#0070f3] cursor-pointer">
            <span>Przeczytaj cały przewodnik</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
